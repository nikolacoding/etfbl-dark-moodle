{
  "manifest_version": 3,
  "name": "ETF Dark Mode",
  "version": "1.2",
  "description": "Tamna tema za Moodle, raspored i glavni sajt ETFBL-a",
  "content_scripts": [
    {
      "matches": [
        "https://el.etfbl.net/*"
      ],
      "css": ["dark.css"]
    },
    {
      "matches": [
        "https://efee.etf.unibl.org/raspored/*"
      ],
      "css": ["raspored.css"]
    },
    {
      "matches": [
        "https://etf.unibl.org/*"
      ],
      "css": ["etf.css"]
    }
  ]
}