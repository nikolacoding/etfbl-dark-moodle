{
  "manifest_version": 3,
  "name": "ETFBL Dark Mode",
  "version": "1.41",
  "description": "Tamna tema za ETFBL platforme",
  "permissions": ["storage"],
  "icons": {
    "16": "etfbl_logo_16.png",
    "48": "etfbl_logo_48.png",
    "128": "etfbl_logo_128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "etfbl_logo_16.png",
      "48": "etfbl_logo_48.png",
      "128": "etfbl_logo_128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["*://el.etfbl.net/*"],
      "css": ["dark.css"],
      "js": ["content.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["*://efee.etf.unibl.org/raspored*"],
      "css": ["raspored.css"],
      "js": ["content.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["*://etf.unibl.org/*"],
      "css": ["etf.css"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "dark.css",
        "raspored.css",
        "etf.css",
        "banner-dark.png"
      ],
      "matches": [
        "*://el.etfbl.net/*",
        "*://efee.etf.unibl.org/*",
        "*://etf.unibl.org/*"
      ]
    }
  ]
}